@model List<EQL.Controllers.CharacterSummary>
@{
    ViewData["Title"] = "Inventories";
    int itemCount = ViewBag.ItemCount;
}
<h1>Inventories</h1>
<partial name="_Messages" />

@if (itemCount == 0)
{
    <div class="alert alert-warning">
        No items are loaded yet, so nothing will match. <a asp-controller="Items" asp-action="Import">Load items.csv</a> first.
    </div>
}

<form asp-action="Upload" method="post" enctype="multipart/form-data" class="card card-body mb-4" style="max-width: 36rem">
    <h2 class="h5">Upload an inventory file</h2>
    <p class="small text-muted mb-2">
        The game's inventory output (tab-separated with a Name column), a CSV with a Name column,
        or a plain list with one item name per line. A name ending in "+3" is read as an item at tier +3.
        Uploading again for the same character replaces their old inventory.
    </p>
    <div class="mb-2">
        <label class="form-label" for="character">Character name</label>
        <input class="form-control" id="character" name="character" placeholder="Leave blank to use the file name (Dave-Inventory.txt → Dave)" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="file">Inventory file</label>
        <input class="form-control" type="file" id="file" name="file" accept=".txt,.csv,.tsv" required />
    </div>
    <button class="btn btn-primary" type="submit">Upload</button>
</form>

@if (Model.Count > 0)
{
    <table class="table table-sm align-middle" style="max-width: 48rem">
        <thead><tr><th>Character</th><th>Lines</th><th>Matched</th><th></th></tr></thead>
        <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Character</td>
                <td>@c.Lines</td>
                <td>@c.Matched</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-character="@c.Character">View</a>
                    <a class="btn btn-sm btn-primary" asp-action="Optimize" asp-route-character="@c.Character">Optimize</a>
                    <form asp-action="Delete" method="post" class="d-inline">
                        <input type="hidden" name="character" value="@c.Character" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
